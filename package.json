{
  "name": "no-name",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.server.json && node --watch dist/server/apps/server/index.js",
    "build": "tsc --noEmit && vite build --configLoader native && tsc -p tsconfig.server.json",
    "start": "node dist/server/apps/server/index.js",
    "test": "tsc -p tsconfig.test.json && node --test dist/tests/tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write apps packages tests *.json *.md"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.3.6"
  }
}
